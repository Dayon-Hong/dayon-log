---
const { postId } = Astro.props;
---
<div class="like-control" data-like-post={postId}>
  <button type="button" class="like-button" aria-pressed="false" disabled>
    <span class="like-heart" aria-hidden="true">♡</span>
    <span class="like-text">좋아요 준비 중</span>
    <span class="like-count" hidden></span>
  </button>
  <p class="like-note">좋아요 집계는 추후 제공됩니다.</p>
</div>

<script>
  import { addLike, getLikeState, likesAvailable, type LikeState } from '../lib/likes';

  document.querySelectorAll<HTMLElement>('[data-like-post]').forEach((control) => {
    const postId = control.dataset.likePost;
    const button = control.querySelector<HTMLButtonElement>('button');
    const heart = control.querySelector<HTMLElement>('.like-heart');
    const label = control.querySelector<HTMLElement>('.like-text');
    const count = control.querySelector<HTMLElement>('.like-count');
    const note = control.querySelector<HTMLElement>('.like-note');
    if (!postId || !button || !heart || !label || !count || !note || !likesAvailable) return;

    function render(state: LikeState) {
      heart!.textContent = state.liked ? '♥' : '♡';
      label!.textContent = '좋아요';
      count!.textContent = state.count.toLocaleString('ko-KR');
      count!.hidden = false;
      button!.setAttribute('aria-pressed', String(state.liked));
      button!.disabled = state.liked;
      button!.classList.toggle('liked', state.liked);
      note!.textContent = state.liked ? '좋아요를 눌렀습니다.' : '';
    }

    getLikeState(postId).then(render).catch(() => {
      note.textContent = '좋아요를 불러올 수 없습니다.';
    });

    button.addEventListener('click', async () => {
      button.disabled = true;
      try {
        render(await addLike(postId));
      } catch {
        note.textContent = '잠시 후 다시 시도해 주세요.';
        button.disabled = false;
      }
    });
  });
</script>
