---
import '../styles/global.css';
import { path, posts } from '../lib/blog';
import { categories, categoryUrl } from '../lib/categories';
const allPosts = await posts();
const isBlog = Astro.url.pathname.startsWith(path('blog'));
const activeCategory = categories.find((item) => Astro.url.pathname.startsWith(categoryUrl(item.slug)));
const { title = 'dayon.log', description = '개발하며 배우고 기록하는 공간', image = path('og.svg'), article } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html><html lang="ko"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#fffaf9"/><title>{title} · dayon.log</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:type" content={article ? "article" : "website"}/><meta name="twitter:card" content="summary_large_image"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>{image && <meta property="og:image" content={new URL(image, Astro.site)}/>}<link rel="icon" type="image/svg+xml" href={path('favicon.svg')}/><link rel="alternate" type="application/rss+xml" title="dayon.log RSS" href={path('rss.xml')}/><script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}catch{}</script>{article && <script type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'BlogPosting', headline:title, description, url:canonical.href, datePublished:article.pubDate.toISOString(), dateModified:(article.updatedDate||article.pubDate).toISOString(), author:{'@type':'Person',name:'다연'}, mainEntityOfPage:canonical.href }).replace(/</g, '\u003c')} />}</head>
<body><a class="skip-link" href="#main-content">본문으로 이동</a><header class="topbar"><a class="brand" href={path('')}><span class="dot"></span>dayon.log</a><nav aria-label="상단 메뉴"><a href={path('')}>Home</a><a href={path('blog')}>Posts <span class="nav-count">{allPosts.length}</span></a><a href={path('tags')}>Tags</a><a href={path('about')}>About</a></nav><a class="header-search" href={path('blog#search')} aria-label="게시글 검색"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="10.7" cy="10.7" r="6.5"/><path d="m16 16 4.4 4.4"/></svg></a><button class="theme" type="button" aria-label="다크 모드 전환" id="theme-toggle">☾</button></header><div class="site"><aside class="sidebar"><img class="avatar" src={path('profile-image.png')} alt="다연 프로필 사진"/><h2>다연</h2><p>개발하며 배우고 기록하는 공간.<br/>백엔드 · 데이터베이스 · 인프라</p>
<div class="social-links" aria-label="다연의 링크">
  <a href="https://github.com/Dayon-Hong" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.54v-2.13c-3.1.67-3.76-1.32-3.76-1.32-.5-1.27-1.23-1.61-1.23-1.61-1.01-.7.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15.99 1.7 2.59 1.21 3.22.93.1-.72.39-1.21.71-1.49-2.48-.28-5.09-1.24-5.09-5.49 0-1.21.43-2.2 1.15-2.98-.11-.28-.5-1.41.11-2.94 0 0 .94-.3 3.05 1.14A10.6 10.6 0 0 1 12 6.45c.94 0 1.88.13 2.76.37 2.11-1.44 3.04-1.14 3.04-1.14.61 1.53.23 2.66.12 2.94.72.78 1.14 1.77 1.14 2.98 0 4.26-2.61 5.2-5.1 5.48.4.35.76 1.03.76 2.08v2.83c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"/></svg></a>
  <a href="https://www.linkedin.com/in/다연-홍-336a13253" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.4 2H3.6A1.6 1.6 0 0 0 2 3.6v16.8A1.6 1.6 0 0 0 3.6 22h16.8a1.6 1.6 0 0 0 1.6-1.6V3.6A1.6 1.6 0 0 0 20.4 2ZM7.9 18.6H4.9V9.2h3v9.4ZM6.4 7.9a1.7 1.7 0 1 1 0-3.4 1.7 1.7 0 0 1 0 3.4Zm12.2 10.7h-3v-4.6c0-1.1 0-2.5-1.6-2.5s-1.8 1.2-1.8 2.4v4.7h-3V9.2h2.9v1.3h.1c.4-.8 1.4-1.6 2.8-1.6 3 0 3.6 2 3.6 4.5v5.2Z"/></svg></a>
  <a href="mailto:dayon0325@gmail.com" aria-label="이메일"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></svg></a>
  <a href={path('rss.xml')} aria-label="RSS 피드"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="5" cy="19" r="1.2" fill="currentColor" stroke="none"/><path d="M4 11a9 9 0 0 1 9 9M4 5a15 15 0 0 1 15 15"/></svg></a>
</div>
<nav class="side-links" aria-label="사이드바 메뉴">
  <a href={path('')} aria-current={Astro.url.pathname === path('') ? 'page' : undefined}><span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3.5 10 8.5-7 8.5 7v10a1 1 0 0 1-1 1h-5.2v-6.2H9.7V21H4.5a1 1 0 0 1-1-1z"/></svg></span> Home</a>
  <div class="sidebar-posts-row"><a href={path('blog')} aria-current={Astro.url.pathname === path('blog') || Astro.url.pathname === path('blog/') ? 'page' : undefined} class:list={{'nav-active':isBlog}}><span aria-hidden="true">▤</span> Posts <small class="post-count">({allPosts.length})</small></a><button type="button" id="categories-toggle" aria-label={isBlog ? '게시글 카테고리 접기' : '게시글 카테고리 펼치기'} aria-controls="sidebar-categories" aria-expanded={isBlog}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button></div>
  <div id="sidebar-categories" class="sidebar-categories" hidden={!isBlog}>
    {categories.map((item) => <a href={categoryUrl(item.slug)} class:list={{'category-active':activeCategory?.slug === item.slug}} aria-current={activeCategory?.slug === item.slug ? 'page' : undefined}><span>{item.name}</span><span class="category-count">{allPosts.filter((post) => post.data.category === item.name).length}</span></a>)}
  </div>
  <a href={path('tags')} aria-current={Astro.url.pathname.startsWith(path('tags')) ? 'page' : undefined}><span aria-hidden="true">◇</span> Tags</a>
  <a href={path('about')} aria-current={Astro.url.pathname.startsWith(path('about')) ? 'page' : undefined}><span aria-hidden="true">◉</span> About</a>
</nav></aside><main id="main-content"><slot /></main></div><footer>© {new Date().getFullYear()} dayon.log · Built with Astro</footer><script is:inline>const root=document.documentElement;document.querySelector('#theme-toggle')?.addEventListener('click',()=>{const next=root.dataset.theme==='dark'?'light':'dark';root.dataset.theme=next;try{localStorage.setItem('theme',next)}catch{}});const toggle=document.querySelector('#categories-toggle');const panel=document.querySelector('#sidebar-categories');toggle?.addEventListener('click',()=>{if(!panel)return;panel.hidden=!panel.hidden;toggle.setAttribute('aria-expanded',String(!panel.hidden));toggle.setAttribute('aria-label',panel.hidden?'게시글 카테고리 펼치기':'게시글 카테고리 접기')});</script></body></html>
