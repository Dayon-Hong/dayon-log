---
import Base from '../../layouts/Base.astro';import LikeButton from '../../components/LikeButton.astro';import { posts, path } from '../../lib/blog';import { render } from 'astro:content';
export async function getStaticPaths(){return (await posts()).map(post=>({params:{slug:post.id},props:{post}}))}
const { post } = Astro.props;const { Content, headings }=await render(post);
---
<Base title={post.data.title} description={post.data.description} article={post.data}><article class="article"><a class="back" href={path('blog')}>← 모든 글</a><span class="eyebrow">{post.data.category}</span><h1>{post.data.title}</h1><p class="article-description">{post.data.description}</p><div class="article-meta"><time datetime={post.data.pubDate.toISOString()}>작성 {post.data.pubDate.toLocaleDateString('ko-KR')}</time>{post.data.updatedDate && <span>수정 {post.data.updatedDate.toLocaleDateString('ko-KR')}</span>}</div><div class="chips">{post.data.tags.map((tag: string)=><a href={path(`tags/${encodeURIComponent(tag)}`)}>#{tag}</a>)}</div>{headings.length>0 && <details class="toc" open><summary>목차</summary><ol>{headings.filter(h=>h.depth<=3).map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></details>}<div class="prose"><Content /></div>{post.data.originalUrl && <p class="muted">이 글의 원본: <a href={post.data.originalUrl}>Velog에서 읽기</a></p>}<div class="article-bottom"><LikeButton postId={post.id}/></div></article><script>document.querySelectorAll('.prose pre').forEach(pre=>{const button=document.createElement('button');button.textContent='복사';button.className='copy-code';button.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(pre.querySelector('code')?.textContent||'');button.textContent='복사됨'}catch{button.textContent='복사 실패'}});pre.append(button)});</script></Base>
