---
import Base from '../../layouts/Base.astro';
import { posts, path } from '../../lib/blog';

const all = await posts();
const tags = [...new Set(all.flatMap((post) => post.data.tags))]
  .map((name) => ({ name, count: all.filter((post) => post.data.tags.includes(name)).length }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
---

<Base title="Tags" description="dayon.log의 기술 태그 탐색">
  <div class="page-heading tags-heading">
    <h1>Tags</h1>
    <p>태그를 누르면 관련 글을 모아볼 수 있어요.</p>
  </div>

  <nav class="tag-list" aria-label="전체 태그">
    {tags.map((tag) =>
      <a class="tag-link" href={path(`tags/${encodeURIComponent(tag.name)}`)}>
        <span>#{tag.name}</span><span class="tag-count">{tag.count}</span>
      </a>
    )}
  </nav>
</Base>
